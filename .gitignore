# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# JetBrains IDE
.idea/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# private CV source (only the PDF is published)
/public/Basel_Kaffoura_CV.docx

# local Claude Code settings
/.claude/settings.local.json

# private documents (personal data; never publish)
/private/
